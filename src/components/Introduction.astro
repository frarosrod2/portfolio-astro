---
import Image from "astro/components/Image.astro";
import angular from "../assets/images/angular.png";
import css from "../assets/images/css-3.png";
import developer from "../assets/images/developer.png";
import js from "../assets/images/js.png";
import node from "../assets/images/node-js.png";
import react from "../assets/images/react.png";
import typescript from "../assets/images/typescript.png";
import resume from "../assets/resume.pdf";
import Logo from "./Logo.astro";

const techSkills = [
  { name: "JS", icon: js },
  { name: "TS", icon: typescript },
  { name: "Angular", icon: angular },
  { name: "React", icon: react },
  { name: "CSS", icon: css },
  { name: "Node", icon: node },
];
---

<section class="introduction-section">
  <div class="intro-wrapper">
    <div class="intro-content">
      <div class="headings">
        <h1 class="name">Francisco Javier Rosa</h1>
        <p class="role">Full Stack Developer</p>
      </div>
      <div class="primary-text mt-10">
        Hi, my name is Francisco Javier Rosa, a young Full Stack Software
        Developer trying to improve his programming skills everyday. I have a
        Software Engineering Degree and I love creating websites.
      </div>
      <div class="languages mt-8 mb-8">
        {
          techSkills.map((skill) => (
            <Logo img={skill.icon} alt={skill.name} width={30} />
          ))
        }
      </div>
      <div class="resume">
        <a href={resume} download="resume.pdf" class="resume-button">
          Download resume
        </a>
      </div>
    </div>
    <div class="developer-wrapper">
      <Image
        src={developer}
        alt="Developer illustration"
        class="developer-img"
        width={520}
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .introduction-section {
    font-family: "Golos Text", "Roboto", cursive;
    font-weight: bold;
    width: 83%;
    margin: 0 auto;
    margin-top: 3rem;
    margin-bottom: 5rem;
  }

  @media (min-width: 640px) {
    .introduction-section {
      width: 75%;
    }
  }

  @media (min-width: 768px) {
    .introduction-section {
      width: 91%;
      padding-top: 3rem;
    }
  }

  .intro-wrapper {
    display: flex;
    flex-basis: 100%;
    flex-wrap: wrap;
  }

  .intro-content {
    width: 100%;
  }

  @media (768px <= width < 1024px) {
    .intro-content {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  @media (width >= 1024px) {
    .intro-content {
      width: 58.33%;
    }

    .developer-wrapper {
      width: 41.67%;
      margin-top: 0;
      display: block;
      padding-left: 2rem;
      margin: auto;
    }

    .introduction-section {
      width: 83%;
    }
  }

  .name {
    font-size: clamp(20px, 5vw, 46px);
    color: white;
    line-height: 1;
  }

  .role {
    font-size: clamp(20px, 4vw, 32px);
    color: #00ff7c;
    line-height: 0.7;
    margin: 15px 0 0;
  }

  .primary-text {
    font-weight: 400;
    color: white;
    font-size: 18px;
  }

  .languages {
    display: flex;
    row-gap: 2rem;
    column-gap: 3rem;
    flex-wrap: wrap;
  }

  .resume {
    margin-top: 1rem;
  }

  .resume-button {
    display: inline-block;
    border: 1px solid #00ff7c;
    padding: 0.75rem;
    color: white;
    border-radius: 10px;
    font-weight: normal;
    background-color: #00307942;
    text-decoration: none;
    cursor: pointer;
  }

  @media (width < 1024px) {
    .developer-wrapper {
      display: none;
    }
  }

  .developer-img {
    max-width: 520px;
    margin: auto;
    width: 90%;
  }
</style>
