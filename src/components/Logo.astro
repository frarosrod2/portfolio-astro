---
import type { ImageMetadata } from "astro";
import Image from "astro/components/Image.astro";

interface Props {
    img: ImageMetadata;
    link?: string;
    alt: string;
    width?: number;
    isNewTab?: boolean;
}

const { img, link, alt, width, isNewTab } = Astro.props;
---

{
    link ? (
        <a
            href={link}
            {...(isNewTab
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
        >
            <Image class="logo-img" src={img} alt={alt} width={width} />
        </a>
    ) : (
        <Image class="logo-img" src={img} alt={alt} width={width} />
    )
}

<style>
    .logo-img {
        object-fit: contain;
    }
</style>
