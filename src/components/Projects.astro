---
import Image from "astro/components/Image.astro";
import naturgyLogo from "../assets/images/Naturgy.png";
import jesusRosaLogo from "../assets/images/jesus-rosa-sl.png";
import wedding from "../assets/images/jesus-noe.png";

const projects = [
  {
    id: 1,
    name: "Naturgy",
    web: "Contratación Online",
    description:
      "Maintenance of the Naturgy Online Contracting section and the Client Area, in addition to the implementation of new functionalities such as the flat rate calculator and the location search engine.",
    img: naturgyLogo,
    alt: "Naturgy thumbnail",
    url: "https://www.naturgy.es/hogar/luz/tarifa_plana_zen_luz#precios-y-condiciones",
    disabled: false,
  },
  {
    id: 2,
    name: "Jesús Rosa SL",
    web: "Car workshop",
    description:
      "Web development for a car workshop to display information about their services.",
    img: jesusRosaLogo,
    alt: "Jesús Rosa SL thumbnail",
    url: "",
    disabled: true,
  },
  {
    id: 3,
    name: "Wedding gallery",
    web: "Wedding gallery",
    description:
      "Wedding image gallery, where guests can upload their images and vote for their favourites, similar to a social network (link is disabled because there are personal images).",
    img: wedding,
    alt: "Wedding gallery thumbnail",
    url: "",
    disabled: true,
  },
];
---

<section id="projects" class="projects-section">
  <h2 class="section-title">03. Projects</h2>
  <div class="projects-list">
    {
      projects.map((project) => (
        <article class="project">
          <div class="project-thumbnail">
            {project.disabled ? (
              <div class="thumbnail-container disabled">
                <Image
                  src={project.img}
                  alt={project.alt}
                  width={600}
                  class="thumbnail-img"
                />
                <div class="thumbnail-footer">
                  <span>{project.name}</span>
                </div>
              </div>
            ) : (
              <a
                href={project.url}
                target="_blank"
                rel="noreferrer"
                class="thumbnail-container"
              >
                <Image
                  src={project.img}
                  alt={project.alt}
                  width={600}
                  class="thumbnail-img"
                />
                <div class="thumbnail-footer">
                  <span>{project.name}</span>
                </div>
              </a>
            )}
          </div>
          <div class="card">
            <h3 class="project-name">{project.name}</h3>
            <h4 class="web-name">{project.web}</h4>
            <div class="overflow-section">
              <span title={project.description}>{project.description}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects-section {
    width: 80%;
    margin: 0 auto;
    padding-bottom: 8rem; /* pb-32 */
  }

  @media (min-width: 768px) {
    .projects-section {
      width: 91%; /* md:w-11/12 */
    }
  }

  @media (min-width: 1024px) {
    .projects-section {
      width: 80%;
    }
  }

  .section-title {
    font-family: "Golos Text", "Roboto", cursive;
    font-weight: bold;
    font-size: 32px;
    color: white;
    text-align: center;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 8rem; /* gap-40 */
    margin-top: 4rem; /* mt-20 */
  }

  .project {
    display: block;
  }

  @media (min-width: 1025px) {
    .project {
      display: flex;
    }
  }

  .project-thumbnail {
    width: 100%;
    overflow: hidden;
  }

  @media (min-width: 1025px) {
    .project-thumbnail {
      flex-basis: 58%; /* lg:basis-7/12 */
    }

    .card {
      flex-basis: 42%; /* lg:basis-5/12 */
    }
  }

  .thumbnail-container {
    position: relative;
    overflow: hidden;
    border-radius: 5px;
  }

  .thumbnail-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .thumbnail-container:not(:hover)::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: rgba(0, 0, 0, 0.05);
    z-index: 999;
  }

  .thumbnail-container:not(:hover) .thumbnail-footer {
    position: absolute;
    visibility: hidden;
    transform: translateY(100%);
  }

  .thumbnail-container .disabled,
  .thumbnail-container.disabled {
    pointer-events: none;
    cursor: auto !important;
  }

  .thumbnail-container:hover {
    cursor: pointer;
    opacity: 1;
  }

  .thumbnail-container:hover .thumbnail-footer {
    z-index: 0;
    background-color: rgba(126, 126, 126, 0.873);
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 60px;
    text-align: center;
    color: white;
    transform: translateY(0%);
    transition: transform 0.5s ease-in-out;
  }

  .thumbnail-container:hover .thumbnail-footer span {
    line-height: 60px;
    vertical-align: middle;
  }

  .card {
    position: relative;
    z-index: 1;
  }

  .project-name {
    font-size: clamp(16px, 4vw, 24px);
    font-family: "Belanosima", sans-serif;
    font-weight: normal;
    color: white;
    text-align: right;
    margin: 0;
  }

  .web-name {
    font-family: "Belanosima", sans-serif;
    font-weight: lighter;
    color: #b9b9b9;
    text-align: right;
    font-size: clamp(14px, 3vw, 20px);
    margin: 0;
  }

  .overflow-section {
    background-color: #1f586a;
    width: 110%;
    transform: translateX(-9%);
    opacity: 1;
    color: white;
    font-weight: lighter;
    z-index: 2;
    padding: 25px;
    border-radius: 4px;
    position: relative;
    box-shadow: 0 10px 30px -15px #000;
    max-height: 70%;
    margin-top: 2rem;
    text-align: justify;
    font-family: "Golos Text", "Roboto", cursive;
  }

  .overflow-section span {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1024px) {
    .project {
      display: block;
    }

    .overflow-section {
      margin-top: 0;
      width: 100% !important;
      transform: translateX(0%) !important;
      margin-top: 1rem !important;
    }

    .project-name {
      text-align: left !important;
      margin-top: 1.75rem;
    }

    .web-name {
      text-align: left !important;
    }
  }
</style>