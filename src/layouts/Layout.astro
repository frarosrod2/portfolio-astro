---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
import golos400Url from "../assets/fonts/golos-text-400.woff2";
import golos700Url from "../assets/fonts/golos-text-700.woff2";

const {
	title = "Francisco Javier Rosa | Full Stack Developer",
	description = "Portfolio of Francisco Javier Rosa, Full Stack Developer specialising in JavaScript, TypeScript, Angular and React. Software Engineering Degree from the University of Seville.",
} = Astro.props;

const site = Astro.site ?? new URL("http://localhost:4321");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL("og-image.png", site);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Francisco Javier Rosa",
	jobTitle: "Full Stack Developer",
	url: new URL("/", site).toString(),
	image: ogImage.toString(),
	description,
	sameAs: [
		"https://www.linkedin.com/in/francisco-javier-rosa-rodr%C3%ADguez-459119200",
		"https://github.com/frarosrod2",
	],
	worksFor: {
		"@type": "Organization",
		name: "Minsait",
	},
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "University of Seville",
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" as="font" type="font/woff2" crossorigin href={golos400Url} />
		<link rel="preload" as="font" type="font/woff2" crossorigin href={golos700Url} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Francisco Javier Rosa" />
		<meta name="theme-color" content="#1b3a68" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Francisco Javier Rosa" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Navbar />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto',
			'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans',
			'Helvetica Neue', sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		background-color: rgba(27, 58, 104, 0.98);
	}
</style>